# Secrets. The Deploy to Cloudflare button prompts for every uncommented key here, so only production
# secrets stay uncommented. Locally: copy to .dev.vars (gitignored); `pnpm dev` runs in mock mode
# (fixtures, fake user, mock AI and GitHub) without it. Manual deploys: `npx wrangler secret put NAME`.

# Session signing and GitHub token encryption. Any random string of 32+ characters each,
# e.g. `openssl rand -base64 32`. Keep TOKEN_ENC_KEY stable: changing it signs everyone out of GitHub.
SESSION_SECRET=
TOKEN_ENC_KEY=

# Real mode locally: uncomment to use the local D1 (`pnpm db:migrate`) and your Cloudflare account's Workers AI.
# HAKIT_MOCKS=0

# GitHub App. Normally created for you at /setup on first sign-in and stored encrypted in D1;
# set these only to use an App you created by hand (docs/SETUP.md §4). Key: PKCS#8, newlines as \n.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=

# Public URL, if it differs from the host requests arrive on. Defaults to the request origin.
# APP_URL=

# Optional AI fallbacks, used only when set. Workers AI needs no key.
# GEMINI_API_KEY=
# HF_TOKEN=

# Live checks and evals outside the worker (check:llm, eval:planning, check:embeddings) call Workers AI
# over REST with these. Token needs Workers AI read + edit.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# E2E only (T-701): enables POST /api/v1/auth/test-login. Never set in production.
# E2E_LOGIN_ENABLED=1
# E2E_LOGIN_SECRET=
