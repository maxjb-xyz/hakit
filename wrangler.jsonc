{
  "$schema": "apps/web/node_modules/wrangler/config-schema.json",
  "name": "hakit",
  "main": "./apps/web/src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"],
  },
  // D1 (SQLite). The Deploy button creates the database and fills in its ID. Manual setup: `npx wrangler d1 create
  // hakit`; Wrangler finds it by name. Migrations: packages/db/migrations, applied by `pnpm run deploy`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hakit",
      "migrations_dir": "packages/db/migrations",
    },
  ],
  // Workers AI: plans, ideas and explanations (AI_MODEL_*) and Qwen3 embeddings. No API key needed.
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": { "bindings": [{ "name": "PROJECT_ROOM", "class_name": "ProjectRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "hakit-jobs" }],
    "consumers": [
      { "queue": "hakit-jobs", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "hakit-dlq" },
    ],
  },
  "triggers": { "crons": ["*/2 * * * *"] },
  // Agent hook ingestion: 120 events per minute per token (T-601). Plugin sends at most ~1 per 10s per session.
  "ratelimits": [
    { "name": "AGENT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    "HAKIT_MOCKS": "0",
    "AI_MODEL_PLAN": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "AI_MODEL_FAST": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "EMBED_MODEL": "Qwen/Qwen3-Embedding-0.6B",
    "EMBED_DIM": "1024",
    // Daily AI units per workspace, reset at 00:00 UTC; "0" = unlimited. Units are weighted calls: plan-tier
    // generation 10, fast-tier 2, embedding request 1 (1 unit ≈ 15 neurons, so the free plan's 10,000
    // neurons/day ≈ 650 units). 300 units (≈ 4,500 neurons) is about six plan generations plus ideas,
    // explanations and embeddings for one team, while no single workspace can take more than half the
    // account's free allowance. On Workers Paid raise it, or set "0".
    "AI_DAILY_LIMIT_PER_WORKSPACE": "300",
  },
}
