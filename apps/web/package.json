{
  "name": "@hakit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler d1 migrations apply DB --remote --config ../../wrangler.jsonc && vite build && wrangler deploy --config dist/hakit/wrangler.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:github": "vitest run github src/worker/jobs/index.test.ts --reporter=verbose",
    "test:realtime": "vitest run project-socket ws.test realtime project-room --reporter=verbose",
    "cf-typegen": "wrangler types --include-runtime false --config ../../wrangler.jsonc",
    "test:e2e": "playwright test",
    "test:embeddings": "vitest run embeddings embed-batch health-embeddings --reporter=verbose",
    "check:embeddings": "node --experimental-strip-types scripts/check-embeddings.mjs",
    "test:skills": "vitest run src/worker/services/skills/github.test.ts src/worker/jobs/skills-import.test.ts src/worker/routes/capability-import.test.ts --reporter=verbose",
    "test:capability": "vitest run src/worker/routes/capability.test.ts --reporter=verbose",
    "test:ai": "vitest run src/worker/services/ai --reporter=verbose",
    "check:llm": "vitest run --config scripts/llm.live.config.ts",
    "test:evals": "vitest run src/worker/services/ai/evals --reporter=verbose",
    "eval:planning:offline": "vitest run --config scripts/planning.offline.config.ts && node scripts/planning-report.mjs",
    "eval:planning": "vitest run --config scripts/planning.live.config.ts",
    "demo": "pnpm --filter @hakit/db exec tsx ../../apps/web/scripts/demo/cli.ts",
    "test:ideas": "vitest run src/worker/routes/ideas.real.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@hakit/contracts": "workspace:*",
    "@hakit/db": "workspace:*",
    "@hakit/engine": "workspace:*",
    "@hakit/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
